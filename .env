# Tender Tracker Pro - Development Environment

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./tender_tracker.db

# JWT Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Application
APP_NAME=Tender Tracker Pro
APP_VERSION=1.0.0
