# Tender Tracker Pro - Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=tender_pass_CHANGE_IN_PRODUCTION
POSTGRES_DB=tender_tracker

# Full database URL (for standalone deployments without docker-compose)
# DATABASE_URL=postgresql+asyncpg://tender_user:password@localhost:5432/tender_tracker

# For development with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./tender_tracker.db

# =============================================================================
# AUTHENTICATION
# =============================================================================
# IMPORTANT: Generate a secure random key for production!
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-CHANGE-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 hours

# =============================================================================
# CORS & API
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true  # Set to false in production

# =============================================================================
# FRONTEND BUILD (for Docker)
# =============================================================================
VITE_API_URL=http://localhost:8000

# =============================================================================
# OPTIONAL: LLM Configuration
# =============================================================================
# LLM_MODEL_PATH=/path/to/gemma-3n
# LLM_DEVICE=cpu
