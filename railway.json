{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "./Dockerfile",
        "watchPatterns": [
            "requirements-prod.txt",
            "src/**",
            "config/**",
            "railway.json",
            "Dockerfile"
        ]
    },
    "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "startupTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
    }
}
